{
  "expo": {
    "name": "PocketOps",
    "slug": "pocketops",
    "scheme": "pocketops",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.pocketops.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pocketops.mobile"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7077a14-20cb-47b6-8f9b-fa7b2425e95b"
      }
    },
    "owner": "ayomight",
    "runtimeVersion": "0.1.0-ui.1",
    "updates": {
      "url": "https://u.expo.dev/b7077a14-20cb-47b6-8f9b-fa7b2425e95b",
      "enabled": true
    },
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "hidden": false
    }
  }
}
