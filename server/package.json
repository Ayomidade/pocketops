{
  "name": "@pocketops/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "lint": "eslint src tests scripts eslint.config.js vitest.config.js",
    "db:migrate": "node src/db/migrate.js up",
    "db:migrate:undo": "node src/db/migrate.js down",
    "db:migrate:undo:all": "node src/db/migrate.js down --all",
    "api:contract": "node scripts/generate-openapi.js",
    "api:contract:check": "node scripts/generate-openapi.js --check"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
