NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://pocketops:pocketops@localhost:54432/pocketops
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=debug
# Leave all OAuth values empty until a GitHub OAuth App and reachable callback exist.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
MOBILE_AUTH_REDIRECT_URI=
API_PUBLIC_URL=
# Leave all GitHub App values empty until the GitHub App is registered and configured.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_OAUTH_CALLBACK_URL=
GITHUB_APP_SETUP_CALLBACK_URL=
GITHUB_APP_MOBILE_REDIRECT_URI=
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
