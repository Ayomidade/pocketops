NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://pocketops:pocketops@localhost:54432/pocketops
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=debug
# Leave all OAuth values empty until a GitHub OAuth App and reachable callback exist.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
MOBILE_AUTH_REDIRECT_URI=
API_PUBLIC_URL=
# GitHub App settings may be filled incrementally; partial setup does not block startup.
# Repository access stays disabled until all settings below are supplied.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_OAUTH_CALLBACK_URL=
GITHUB_APP_SETUP_CALLBACK_URL=
GITHUB_APP_MOBILE_REDIRECT_URI=
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
# Render reads require the key ring and active version below.
# New deployment dispatch additionally requires DEPLOYMENTS_ENABLED=true.
# The worker is a separate process: npm run worker:deployments (without it,
# accepted deployment operations remain queued and are never dispatched).
DEPLOYMENTS_ENABLED=false
# JSON key ring for encrypting provider credentials at rest, e.g.
# {"v1":"<base64-32-bytes>"}. Generate each with: openssl rand -base64 32
# Store in a secret manager; rotate by adding a new version and changing
# PROVIDER_ACTIVE_KEY_VERSION. Losing all keys requires users to reconnect.
PROVIDER_ENCRYPTION_KEYS=
PROVIDER_ACTIVE_KEY_VERSION=

# Use loopback only for a trusted proxy (e.g. cloudflared) on this host.
TRUST_PROXY=false
